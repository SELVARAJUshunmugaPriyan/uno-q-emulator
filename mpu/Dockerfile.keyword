FROM python:3.13-slim-bookworm

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends openssh-server supervisor ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -m -s /bin/bash arduino \
    && echo 'arduino:arduino' | chpasswd \
    && mkdir -p /run/sshd /var/log/supervisor /home/arduino/.arduino-bricks/ei-models \
    && chown -R arduino:arduino /home/arduino

COPY keyword-entrypoint.sh /usr/local/bin/entrypoint.sh
COPY keyword-supervisord.conf /etc/supervisor/conf.d/keyword.conf
RUN python -m pip install --no-cache-dir fastapi "uvicorn[standard]"
RUN chmod +x /usr/local/bin/entrypoint.sh
EXPOSE 22 9200
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

